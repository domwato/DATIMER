{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "DA Timer",
  "Version": "1.3.1.0",
  "Author": "DA Timer",
  "Description": "Control DA Timer from your Stream Deck: start/stop, next segment, marks, and live segment / program clocks with over/under.",
  "Category": "DA Timer",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "UUID": "io.github.domwato.datimer",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Actions": [
    {
      "UUID": "io.github.domwato.datimer.clock",
      "Name": "Live Clock",
      "Tooltip": "Segment, program, over/under or TOD on a key",
      "Icon": "imgs/actions/clock",
      "States": [
        {
          "Image": "imgs/keys/clock"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.alltoggle",
      "Name": "All Start / Stop",
      "Tooltip": "Toggle both timers",
      "Icon": "imgs/actions/alltoggle",
      "States": [
        {
          "Image": "imgs/keys/alltoggle"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.allstart",
      "Name": "All Start",
      "Tooltip": "Start both timers",
      "Icon": "imgs/actions/allstart",
      "States": [
        {
          "Image": "imgs/keys/allstart"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.allstop",
      "Name": "All Stop",
      "Tooltip": "Stop both timers",
      "Icon": "imgs/actions/allstop",
      "States": [
        {
          "Image": "imgs/keys/allstop"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.segtoggle",
      "Name": "Segment Start / Stop",
      "Tooltip": "Toggle the segment timer",
      "Icon": "imgs/actions/segtoggle",
      "States": [
        {
          "Image": "imgs/keys/segtoggle"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.progtoggle",
      "Name": "Program Start / Stop",
      "Tooltip": "Toggle the program timer",
      "Icon": "imgs/actions/progtoggle",
      "States": [
        {
          "Image": "imgs/keys/progtoggle"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.next",
      "Name": "Next Segment",
      "Tooltip": "End this segment and start the next",
      "Icon": "imgs/actions/next",
      "States": [
        {
          "Image": "imgs/keys/next"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.mark",
      "Name": "Log Mark",
      "Tooltip": "Drop a timestamped MARK in the log",
      "Icon": "imgs/actions/mark",
      "States": [
        {
          "Image": "imgs/keys/mark"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.reset",
      "Name": "Reset Program (hold)",
      "Tooltip": "Hold 1 second to reset the program",
      "Icon": "imgs/actions/reset",
      "States": [
        {
          "Image": "imgs/keys/reset"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.undo",
      "Name": "Undo Last Action",
      "Tooltip": "Undo a reset, next segment, stop/start or preset",
      "Icon": "imgs/actions/undo",
      "States": [
        {
          "Image": "imgs/keys/undo"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    },
    {
      "UUID": "io.github.domwato.datimer.display",
      "Name": "Display Toggle",
      "Tooltip": "Output to monitor, TOD, log or segments panel on/off",
      "Icon": "imgs/actions/display",
      "States": [
        {
          "Image": "imgs/keys/display"
        }
      ],
      "PropertyInspectorPath": "ui/pi.html",
      "Controllers": [
        "Keypad"
      ]
    }
  ]
}